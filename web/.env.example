# Public Yandex Disk photo folder; optional, already the default.
# YANDEX_PHOTOS_URL=https://disk.yandex.ru/d/TpiMfBy9WROTGg

# Yandex Maps JavaScript API 3.0 public browser key (restricted by HTTP Referer).
# Set it in Bothost, not in GitHub:
# YANDEX_MAPS_API_KEY=...

# Vite proxy assumes the Go server is running on port 8080.
